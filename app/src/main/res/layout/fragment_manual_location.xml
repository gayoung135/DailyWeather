<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/white">

    <!-- 상단 안내 텍스트 -->
    <TextView
        android:id="@+id/txtSelectCityTitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="맞춤 정보 제공을 위한\n정보설정을 해주세요"
        android:textColor="#000000"
        android:textSize="18sp"
        android:padding="20dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"/>

    <!-- 하단 패널 -->
    <LinearLayout
        android:id="@+id/bottomPanel"
        android:layout_width="355dp"
        android:layout_height="604dp"
        android:layout_marginStart="10dp"
        android:layout_marginTop="10dp"
        android:layout_marginEnd="10dp"
        android:layout_marginBottom="16dp"
        android:background="@drawable/intro_bottom_panel"
        android:gravity="center_horizontal"
        android:orientation="vertical"
        android:padding="24dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/txtSelectCityTitle"
        app:layout_constraintVertical_bias="0.683">

        <Spinner
            android:id="@+id/spinner"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:background="@drawable/bg_select_box"
            android:paddingStart="16dp"
            />

        <Spinner
            android:id="@+id/spinner2"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:background="@drawable/bg_select_box"
            android:paddingStart="16dp"
            android:enabled="false"/>



    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>