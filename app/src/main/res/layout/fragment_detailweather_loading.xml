<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_gradient">

    <!-- 상단 탭 바 -->
    <LinearLayout
        android:id="@+id/tabBar"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:layout_marginStart="16dp"
        android:layout_marginEnd="16dp"
        android:padding="4dp"
        android:orientation="horizontal"
        android:background="@drawable/bg_tab_group"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <!-- 🔹 맞춤 옷차림 (비활성) -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/tabOutfit"
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:layout_weight="1"
            android:background="@drawable/bg_tab_right"
            android:padding="0dp"
            android:text="맞춤 옷차림"
            android:textColor="#B0B0B0"
            android:textSize="15sp"
            android:textStyle="bold"
            android:alpha="0.4"
            android:elevation="0dp"
            app:backgroundTint="@null" />

        <!-- 🔹 상세 날씨 (현재 선택) -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/tabDetail"
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:layout_weight="1"
            android:background="@drawable/bg_tab_left"
            android:padding="0dp"
            android:text="상세 날씨"
            android:textColor="#333333"
            android:textSize="15sp"
            android:textStyle="bold"
            android:alpha="1"
            android:elevation="0dp"
            app:backgroundTint="@null" />

    </LinearLayout>

    <!-- 🔹 로딩 카드 영역 (화면 중앙 근처) -->
    <LinearLayout
        android:id="@+id/weatherCard"
        android:layout_width="331dp"
        android:layout_height="358dp"
        android:layout_marginStart="32dp"
        android:layout_marginTop="20dp"
        android:layout_marginEnd="32dp"
        android:layout_marginBottom="32dp"
        android:background="@drawable/bg_gradient_round"
        android:gravity="center_horizontal"
        android:orientation="vertical"
        android:padding="24dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/tabBar"
        app:layout_constraintVertical_bias="0.321">


        <!-- 로딩 타이틀 -->
        <TextView
            android:id="@+id/loadingTitleText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="8dp"
            android:gravity="center"
            android:lineSpacingExtra="2dp"
            android:text="상세 날씨 준비 중이에요"
            android:textColor="#000000"
            android:textSize="20sp"
            android:textStyle="bold" />

        <!-- 설명 텍스트 -->
        <TextView
            android:id="@+id/loadingDescText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="20dp"
            android:gravity="center"
            android:lineSpacingExtra="2dp"
            android:text="현재 위치의 기온, 강수량, 대기질, 일주일 예보를\n모으고 있어요."
            android:textColor="#555555"
            android:textSize="14sp" />

        <ImageView
            android:id="@+id/loadingImage"
            android:layout_width="153dp"
            android:layout_height="114dp"
            android:layout_marginTop="8dp"
            android:layout_marginBottom="16dp"
            android:src="@drawable/detailload" />

        <!-- 로딩 인디케이터 -->
        <ProgressBar
            android:id="@+id/loadingProgress"
            style="?android:attr/progressBarStyleLarge"
            android:layout_width="97dp"
            android:layout_height="48dp"
            android:layout_marginTop="10dp"
            android:layout_marginBottom="12dp"
            android:indeterminate="true" />

    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>
