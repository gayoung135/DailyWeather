<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_gradient"
    android:fillViewport="true">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="0dp">

        <!-- 상단 버튼 -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/backButton"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="47dp"
            android:text="맞춤 옷차림"
            android:textColor="#3E3E3E"
            android:textSize="16sp"
            android:minHeight="90dp"
            android:background="@drawable/bg_panel_round"
            app:backgroundTint="@null"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent" />

        <!-- 카드 영역 -->
        <LinearLayout
            android:id="@+id/weatherCard"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="-52dp"
            android:background="@drawable/bg_gradient_round"
            android:orientation="vertical"
            android:padding="24dp"
            android:translationZ="4dp"
            app:layout_constraintTop_toBottomOf="@id/backButton"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent">

            <!-- 위치 및 날짜 -->
            <TextView
                android:id="@+id/locationText"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginBottom="4dp"
                android:text="선택 지역"
                android:textColor="#000000"
                android:textSize="22sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/dateText"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginBottom="16dp"
                android:text="--월 --일 | -요일"
                android:textColor="#555555"
                android:textSize="16sp" />

            <!-- 온도 -->
            <TextView
                android:id="@+id/temperatureText"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center_horizontal"
                android:layout_marginBottom="8dp"
                android:text="NULL°C"
                android:textColor="#000000"
                android:textSize="48sp"
                android:textStyle="bold" />

            <!-- 설명 -->
            <TextView
                android:id="@+id/weatherDescription"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginBottom="24dp"
                android:text="현재 기온과 대기질, 강수확률을 종합한 상세 정보입니다."
                android:textColor="#555555"
                android:textSize="18sp"
                android:gravity="center" />

            <!-- 오늘 요약 카드 -->
            <LinearLayout
                android:id="@+id/todaySummaryCard"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/rounded_box"
                android:orientation="vertical"
                android:padding="16dp"
                android:layout_marginBottom="24dp">

                <TextView
                    android:id="@+id/summaryAmPmText"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="오전:  -  / 오후:  -"
                    android:textColor="#333333"
                    android:textSize="16sp"
                    android:layout_marginBottom="8dp" />

                <TextView
                    android:id="@+id/currentTempSummaryText"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="현재 온도: -°C"
                    android:textColor="#333333"
                    android:textSize="16sp"
                    android:layout_marginBottom="8dp" />

                <TextView
                    android:id="@+id/pm10Text"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="미세먼지: -"
                    android:textColor="#333333"
                    android:textSize="16sp"
                    android:layout_marginBottom="8dp" />

                <TextView
                    android:id="@+id/popText"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="강수확률: -%"
                    android:textColor="#333333"
                    android:textSize="16sp" />
            </LinearLayout>

            <!-- 7일 예보 카드 -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/rounded_box"
                android:orientation="vertical"
                android:padding="16dp">

                <!-- ========================= -->
                <!-- ====== 1일차 라인 ======== -->
                <!-- ========================= -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:layout_marginBottom="8dp">

                    <TextView
                        android:id="@+id/date1"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="--월 --일 (-)"
                        android:textColor="#333333"
                        android:textSize="16sp" />

                    <TextView
                        android:id="@+id/temp1"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:gravity="center"
                        android:text="최저° / 최고°"
                        android:textColor="#333333"
                        android:textSize="16sp" />

                    <TextView
                        android:id="@+id/rain1"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:gravity="end"
                        android:text="0%"
                        android:textColor="#333333"
                        android:textSize="16sp" />
                </LinearLayout>

                <!-- ========================= -->
                <!-- ====== 2일차 ============ -->
                <!-- ========================= -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:layout_marginBottom="8dp">

                    <TextView android:id="@+id/date2"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="--월 --일 (-)" />

                    <TextView android:id="@+id/temp2"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:gravity="center"
                        android:text="최저° / 최고°" />

                    <TextView android:id="@+id/rain2"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:gravity="end"
                        android:text="0%" />
                </LinearLayout>

                <!-- 3~7일차 동일 패턴 -->
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:layout_marginBottom="8dp">
                    <TextView android:id="@+id/date3" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="--월 --일 (-)" />
                    <TextView android:id="@+id/temp3" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:gravity="center" android:text="최저° / 최고°" />
                    <TextView android:id="@+id/rain3" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:gravity="end" android:text="0%" />
                </LinearLayout>

                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:layout_marginBottom="8dp">
                    <TextView android:id="@+id/date4" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="--월 --일 (-)" />
                    <TextView android:id="@+id/temp4" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:gravity="center" android:text="최저° / 최고°" />
                    <TextView android:id="@+id/rain4" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:gravity="end" android:text="0%" />
                </LinearLayout>

                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:layout_marginBottom="8dp">
                    <TextView android:id="@+id/date5" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="--월 --일 (-)" />
                    <TextView android:id="@+id/temp5" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:gravity="center" android:text="최저° / 최고°" />
                    <TextView android:id="@+id/rain5" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:gravity="end" android:text="0%" />
                </LinearLayout>

                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:layout_marginBottom="8dp">
                    <TextView android:id="@+id/date6" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="--월 --일 (-)" />
                    <TextView android:id="@+id/temp6" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:gravity="center" android:text="최저° / 최고°" />
                    <TextView android:id="@+id/rain6" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:gravity="end" android:text="0%" />
                </LinearLayout>

                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal">
                    <TextView android:id="@+id/date7" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="--월 --일 (-)" />
                    <TextView android:id="@+id/temp7" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:gravity="center" android:text="최저° / 최고°" />
                    <TextView android:id="@+id/rain7" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:gravity="end" android:text="0%" />
                </LinearLayout>

            </LinearLayout>
        </LinearLayout>
    </androidx.constraintlayout.widget.ConstraintLayout>
</ScrollView>
