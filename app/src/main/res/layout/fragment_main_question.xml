<?xml version="1.0" encoding="utf-8"?>
<ScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_gradient"
    android:padding="24dp"
    android:fillViewport="true">

    <LinearLayout
        android:orientation="vertical"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

        <!-- 상단 타이틀 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginBottom="8dp">

            <TextView
                android:text="오늘의 맞춤 추천을 위해\n 정보를 선택해주세요"
                android:textSize="20sp"
                android:textStyle="bold"
                android:textColor="#000000"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:layout_marginBottom="8dp" />

            <Button
                android:id="@+id/skipButton"
                android:text="SKIP >"
                android:textSize="14sp"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="?attr/selectableItemBackground"
                android:textColor="#2196F3"
                android:padding="4dp" />
        </LinearLayout>

        <!-- 질문 1 -->
        <TextView
            android:text="오늘은 몇시에 나가시나요?"
            android:textSize="18sp"
            android:textStyle="bold"
            android:textColor="#5e5c5c"
            android:layout_marginTop="24dp"
            android:layout_marginBottom="10dp"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content" />

        <LinearLayout
            android:id="@+id/timeGroup"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:layout_gravity="center_horizontal"
            android:gravity="center_horizontal"
            android:layout_marginBottom="16dp"
            android:padding="0dp"
            android:background="@drawable/btn_white_round">

            <NumberPicker
                android:id="@+id/timePicker"
                android:layout_width="match_parent"
                android:layout_height="150dp"
                android:layout_gravity="center"
                android:layout_marginStart="50dp"
                android:layout_marginEnd="50dp" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center"
                android:layout_marginTop="0dp"
                android:paddingStart="20dp"
                android:paddingEnd="40dp">

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnTimeNo"
                    android:layout_width="0dp"
                    android:layout_height="48dp"
                    android:layout_weight="1"
                    android:layout_margin="8dp"
                    android:text="NO"
                    android:textColor="#3E3E3E"
                    app:strokeWidth="0dp"
                    app:backgroundTint="@android:color/white"
                    app:elevation="6dp"
                    app:cornerRadius="28dp" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnTimeYes"
                    android:layout_width="0dp"
                    android:layout_height="48dp"
                    android:layout_weight="1"
                    android:text="YES"
                    android:textColor="#3E3E3E"
                    app:strokeWidth="0dp"
                    app:backgroundTint="@android:color/white"
                    app:elevation="6dp"
                    app:cornerRadius="28dp" />

            </LinearLayout>
        </LinearLayout>

        <!-- 질문 2 -->
        <TextView
            android:text="외출목적은 무엇인가요?"
            android:textSize="18sp"
            android:textStyle="bold"
            android:textColor="#5e5c5c"
            android:layout_marginTop="24dp"
            android:layout_marginBottom="10dp"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content" />

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/purposeGroup"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:layoutManager="com.google.android.flexbox.FlexboxLayoutManager"
            tools:listitem="@layout/item_option" />

        <!-- 질문 3 -->
        <TextView
            android:text="오늘 기분은 어떠신가요?"
            android:textSize="18sp"
            android:textStyle="bold"
            android:textColor="#5e5c5c"
            android:layout_marginTop="24dp"
            android:layout_marginBottom="10dp"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content" />

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/moodGroup"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:layoutManager="com.google.android.flexbox.FlexboxLayoutManager"
            tools:listitem="@layout/item_option" />

        <!-- 질문 4 -->
        <TextView
            android:text="어떤 스타일을 원하시나요?"
            android:textSize="18sp"
            android:textStyle="bold"
            android:textColor="#5e5c5c"
            android:layout_marginTop="24dp"
            android:layout_marginBottom="10dp"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content" />

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/styleGroup"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:layoutManager="com.google.android.flexbox.FlexboxLayoutManager"
            tools:listitem="@layout/item_option" />

        <!-- 제출 버튼 -->
        <Button
            android:id="@+id/submitButton"
            android:text="추천 받기"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="32dp"
            android:layout_marginBottom="50dp"
            android:backgroundTint="#1976D2"
            android:textColor="#FFFFFF" />

    </LinearLayout>

</ScrollView>