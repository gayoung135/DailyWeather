<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_gradient"
    android:padding="24dp"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <!-- 상단 타이틀 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginBottom="8dp">

            <TextView
                android:text="오늘의 맞춤 추천을 위해\n 정보를 선택해주세요"
                android:textSize="20sp"
                android:textStyle="bold"
                android:textColor="#000000"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:layout_marginBottom="8dp" />

            <Button
                android:id="@+id/skipButton"
                android:text="SKIP >"
                android:textSize="14sp"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="?attr/selectableItemBackground"
                android:textColor="#2196F3"
                android:padding="4dp" />
        </LinearLayout>


        <!-- 질문 1 -->
    <TextView
        android:text="오늘은 몇시에 나가시나요?"
        android:textSize="18sp"
        android:textColor="#000000"
        android:layout_marginTop="24dp"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content" />

        <LinearLayout
            android:id="@+id/timeGroup"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_horizontal"
            android:orientation="vertical"
            android:gravity="center_horizontal"
            android:layout_marginBottom="16dp"
            android:padding="8dp"
            android:background="@drawable/btn_white_round"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent" >


        <NumberPicker
                android:id="@+id/timePicker"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="50dp"
                android:layout_marginEnd="50dp"
                android:layout_gravity="center" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center"
                android:layout_marginTop="16dp"
                android:paddingStart="40dp"
                android:paddingEnd="40dp">

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnTimeNo"
                    style="@style/LeftRoundedButton"
                    android:layout_width="0dp"
                    android:layout_height="48dp"
                    android:layout_weight="1"
                    android:text="NO"
                    android:textColor="#3E3E3E"
                    app:strokeColor="#B0B0B0"
                    app:strokeWidth="1dp"
                    app:backgroundTint="@android:color/white" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnTimeYes"
                    style="@style/RightRoundedButton"
                    android:layout_width="0dp"
                    android:layout_height="48dp"
                    android:layout_weight="1"
                    android:text="YES"
                    android:textColor="#3E3E3E"
                    app:strokeColor="#B0B0B0"
                    app:strokeWidth="1dp"
                    app:backgroundTint="@android:color/white" />
            </LinearLayout>

        </LinearLayout>

    <!-- 질문 2 -->
    <TextView
        android:text="외출목적은 무엇인가요?"
        android:textSize="18sp"
        android:textColor="#000000"
        android:layout_marginTop="24dp"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content" />

    <com.google.android.flexbox.FlexboxLayout
        android:id="@+id/purposeGroup"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        app:flexWrap="wrap"
        app:justifyContent="flex_start"
        app:alignItems="center"
        app:flexDirection="row">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnPurposeWork"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:minWidth="80dp"
            android:text="출근"
            android:textColor="#3E3E3E"
            app:backgroundTint="@color/white"
            app:cornerRadius="16dp"
            android:layout_marginEnd="8dp"
            android:layout_marginBottom="8dp" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnPurposeEvent"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:minWidth="80dp"
            android:text="경사"
            android:textColor="#3E3E3E"
            app:backgroundTint="@color/white"
            app:cornerRadius="16dp"
            android:layout_marginEnd="8dp"
            android:layout_marginBottom="8dp" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnPurposeDate"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:minWidth="80dp"
            android:text="데이트"
            android:textColor="#3E3E3E"
            app:backgroundTint="@color/white"
            app:cornerRadius="16dp"
            android:layout_marginEnd="8dp"
            android:layout_marginBottom="8dp" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnPurposeTrip"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:minWidth="80dp"
            android:text="데이트"
            android:textColor="#3E3E3E"
            app:backgroundTint="@color/white"
            app:cornerRadius="16dp"
            android:layout_marginEnd="8dp"
            android:layout_marginBottom="8dp" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnPurposeNone"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:minWidth="80dp"
            android:text="없음"
            android:textColor="#3E3E3E"
            app:backgroundTint="@color/white"
            app:cornerRadius="16dp"
            android:layout_marginBottom="8dp" />
    </com.google.android.flexbox.FlexboxLayout>

    <!-- 질문 3: 오늘 기분 -->
    <TextView
        android:text="오늘 기분은 어떠신가요?"
        android:textSize="18sp"
        android:textColor="#000000"
        android:layout_marginTop="24dp"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content" />

    <LinearLayout
        android:id="@+id/moodGroup"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginTop="8dp">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnMoodGood"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:minWidth="80dp"
            android:text="좋음"
            android:textColor="#3E3E3E"
            app:backgroundTint="@color/white"
            app:cornerRadius="16dp"
            android:layout_marginEnd="8dp" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnMoodNormal"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:minWidth="80dp"
            android:text="보통"
            android:textColor="#3E3E3E"
            app:backgroundTint="@color/white"
            app:cornerRadius="16dp"
            android:layout_marginEnd="8dp" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnMoodBad"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:minWidth="80dp"
            android:text="나쁨"
            android:textColor="#3E3E3E"
            app:backgroundTint="@color/white"
            app:cornerRadius="16dp" />
    </LinearLayout>

    <!-- 질문 4: 스타일 선택 -->
    <TextView
        android:text="어떤 스타일을 원하시나요?"
        android:textSize="18sp"
        android:textColor="#000000"
        android:layout_marginTop="24dp"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content" />

    <com.google.android.flexbox.FlexboxLayout
        android:id="@+id/styleGroup"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        app:flexWrap="wrap"
        app:justifyContent="flex_start"
        app:alignItems="center"
        app:flexDirection="row">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnStyleStreet"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:minWidth="80dp"
            android:text="스트리트"
            android:textColor="#3E3E3E"
            app:backgroundTint="@color/white"
            app:cornerRadius="16dp"
            android:layout_marginEnd="8dp"
            android:layout_marginBottom="8dp" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnStyleFormal"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:minWidth="80dp"
            android:text="포멀"
            android:textColor="#3E3E3E"
            app:backgroundTint="@color/white"
            app:cornerRadius="16dp"
            android:layout_marginEnd="8dp"
            android:layout_marginBottom="8dp" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnStyleCasual"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:minWidth="80dp"
            android:text="캐주얼"
            android:textColor="#3E3E3E"
            app:backgroundTint="@color/white"
            app:cornerRadius="16dp"
            android:layout_marginEnd="8dp"
            android:layout_marginBottom="8dp" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnStyleLovely"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:minWidth="80dp"
            android:text="러블리"
            android:textColor="#3E3E3E"
            app:backgroundTint="@color/white"
            app:cornerRadius="16dp"
            android:layout_marginEnd="8dp"
            android:layout_marginBottom="8dp" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnStyleNone"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:minWidth="80dp"
            android:text="없음"
            android:textColor="#3E3E3E"
            app:backgroundTint="@color/white"
            app:cornerRadius="16dp"
            android:layout_marginBottom="8dp" />
    </com.google.android.flexbox.FlexboxLayout>
        <!-- 제출 버튼 -->
        <Button
            android:id="@+id/submitButton"
            android:text="추천 받기"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="32dp"
            android:layout_marginBottom="32dp"
            android:backgroundTint="#2196F3"
            android:textColor="#FFFFFF"
            android:elevation="4dp" />

    </LinearLayout>
</ScrollView>
