<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#FAFAFA">

    <!-- 상단 탭 바 -->
    <LinearLayout
        android:id="@+id/tabBar"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:layout_marginStart="16dp"
        android:layout_marginEnd="16dp"
        android:padding="4dp"
        android:orientation="horizontal"
        android:background="@drawable/bg_tab_group"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <!-- 왼쪽: 맞춤 옷차림 (선택됨) -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/tabOutfit"
            style="@style/Widget.MaterialComponents.Button.TextButton"
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:layout_weight="1"
            android:insetLeft="0dp"
            android:insetRight="0dp"
            android:insetTop="0dp"
            android:insetBottom="0dp"
            android:paddingStart="8dp"
            android:paddingEnd="8dp"
            android:text="맞춤 옷차림"
            android:textColor="#333333"
            android:textSize="15sp"
            android:textStyle="bold"
            android:background="@drawable/bg_tab_left"
            android:elevation="0dp"
            app:backgroundTint="@null" />

        <!-- 오른쪽: 상세 날씨 (비활성) -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/tabDetail"
            style="@style/Widget.MaterialComponents.Button.TextButton"
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:layout_weight="1"
            android:insetLeft="0dp"
            android:insetRight="0dp"
            android:insetTop="0dp"
            android:insetBottom="0dp"
            android:paddingStart="8dp"
            android:paddingEnd="8dp"
            android:text="상세 날씨"
            android:textColor="#777777"
            android:textSize="15sp"
            android:background="@drawable/bg_tab_right"
            android:elevation="0dp"
            app:backgroundTint="@null" />
    </LinearLayout>

    <!-- 카드 스타일 배경 -->
    <LinearLayout
        android:id="@+id/resultCard"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:orientation="vertical"
        android:padding="24dp"
        android:background="@drawable/bg_gradient_round"
        android:layout_marginTop="16dp"
    app:layout_constraintTop_toBottomOf="@id/tabBar"
    app:layout_constraintStart_toStartOf="parent"
    app:layout_constraintEnd_toEndOf="parent"
    app:layout_constraintBottom_toBottomOf="parent">

        <ScrollView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:fillViewport="true">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <!-- 제목 -->
                <TextView
                    android:id="@+id/titleText"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="16dp"
                    android:text="오늘의 추천 옷차림"
                    android:textColor="#000000"
                    android:textSize="20sp"
                    android:textStyle="bold" />

                <!-- 🔹 이 부분은 그대로 두기로 했던 문구 -->
                <TextView
                    android:id="@+id/weatherInfo"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="24dp"
                    android:text="질문지 바탕으로 알려드릴게요!"
                    android:textColor="#555555"
                    android:textSize="16sp" />

                <!-- 온도 / 미세먼지 / 강수확률 박스 -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center"
                    android:layout_marginBottom="24dp">

                    <!-- 온도 박스 -->
                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:background="@drawable/rounded_box"
                        android:padding="12dp"
                        android:layout_marginEnd="8dp"
                        android:orientation="vertical"
                        android:gravity="center">

                        <TextView
                            android:id="@+id/tempText"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="코디 온도\n-°C"
                            android:textSize="16sp"
                            android:textColor="#555555"
                            android:gravity="center" />
                    </LinearLayout>

                    <!-- 미세먼지 박스 -->
                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:background="@drawable/rounded_box"
                        android:padding="12dp"
                        android:layout_marginEnd="8dp"
                        android:orientation="vertical"
                        android:gravity="center">

                        <TextView
                            android:id="@+id/pmText"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="미세먼지\n-"
                            android:textSize="16sp"
                            android:textColor="#555555"
                            android:gravity="center" />
                    </LinearLayout>

                    <!-- 강수확률 박스 -->
                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:background="@drawable/rounded_box"
                        android:padding="12dp"
                        android:orientation="vertical"
                        android:gravity="center">

                        <TextView
                            android:id="@+id/rainText"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="강수확률\n-"
                            android:textSize="16sp"
                            android:textColor="#555555"
                            android:gravity="center" />
                    </LinearLayout>
                </LinearLayout>

                <!-- 첫 번째 추천 코디 -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="8dp"
                    android:text="첫 번째 추천 코디"
                    android:textSize="18sp"
                    android:textStyle="bold" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="@drawable/rounded_box"
                    android:padding="16dp"
                    android:layout_marginBottom="24dp"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/outfit1"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="아우터: -\n상의: -\n하의: - \n악세사리: -"
                        android:textSize="16sp"
                        android:textColor="#000000" />
                </LinearLayout>

                <!-- 두 번째 추천 코디 -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="8dp"
                    android:text="두 번째 추천 코디"
                    android:textSize="18sp"
                    android:textStyle="bold" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="@drawable/rounded_box"
                    android:padding="16dp"
                    android:layout_marginBottom="24dp"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/outfit2"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="아우터: -\n상의: -\n하의: - \n악세사리: -"
                        android:textSize="16sp"
                        android:textColor="#000000" />
                </LinearLayout>

                <!-- 오늘의 추천 색깔 -->
                <LinearLayout
                    android:id="@+id/moodSection"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:layout_marginBottom="24dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="8dp"
                        android:text="오늘의 추천 색깔"
                        android:textSize="18sp"
                        android:textStyle="bold" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:background="@drawable/rounded_box"
                        android:padding="16dp"
                        android:layout_marginBottom="24dp"
                        android:orientation="vertical"
                        android:gravity="center_horizontal">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal"
                            android:gravity="center">

                            <View
                                android:id="@+id/moodColor1"
                                android:layout_width="40dp"
                                android:layout_height="40dp"
                                android:layout_marginEnd="8dp"
                                android:background="@drawable/circle_white" />

                            <View
                                android:id="@+id/moodColor2"
                                android:layout_width="40dp"
                                android:layout_height="40dp"
                                android:layout_marginEnd="8dp"
                                android:background="@drawable/circle_pink" />

                            <View
                                android:id="@+id/moodColor3"
                                android:layout_width="40dp"
                                android:layout_height="40dp"
                                android:layout_marginEnd="8dp"
                                android:background="@drawable/circle_blue" />

                            <View
                                android:id="@+id/moodColor4"
                                android:layout_width="40dp"
                                android:layout_height="40dp"
                                android:layout_marginEnd="8dp"
                                android:background="@drawable/circle_purple" />

                            <View
                                android:id="@+id/moodColor5"
                                android:layout_width="40dp"
                                android:layout_height="40dp"
                                android:background="@drawable/circle_yellow" />
                        </LinearLayout>
                    </LinearLayout>
                </LinearLayout>

                <!-- 필수품 -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="8dp"
                    android:text="필수품"
                    android:textSize="18sp"
                    android:textStyle="bold" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:layout_marginBottom="24dp">

                    <!-- 필수품 박스 -->
                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:background="@drawable/rounded_box"
                        android:padding="12dp"
                        android:layout_marginEnd="8dp"
                        android:orientation="vertical">

                        <TextView
                            android:id="@+id/essentials"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="필수품 없음"
                            android:textSize="16sp"
                            android:textColor="#555555"
                            android:gravity="center" />
                    </LinearLayout>
                </LinearLayout>
            </LinearLayout>
        </ScrollView>
    </LinearLayout>
</androidx.constraintlayout.widget.ConstraintLayout>
