<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:padding="16dp"
    android:background="#FAFAFA">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <!-- 제목 -->
        <TextView
            android:id="@+id/titleText"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="오늘의 추천 옷차림"
            android:textSize="20sp"
            android:textStyle="bold"
            android:textColor="#000000"
            android:layout_marginBottom="16dp" />

        <!-- 날씨 정보 -->
        <TextView
            android:id="@+id/weatherInfo"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="32°C / 미세먼지: 나쁨 / 초미세먼지: 높음"
            android:textSize="16sp"
            android:textColor="#555555"
            android:layout_marginBottom="24dp" />

        <!-- 첫 번째 추천 코디 -->
        <TextView
            android:text="첫 번째 추천 코디"
            android:textSize="18sp"
            android:textStyle="bold"
            android:layout_marginBottom="8dp" />

        <TextView
            android:id="@+id/outfit1"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="상의: 반팔\n하의: 반바지\n아우터: 얇은 가디건\n신발: 샌들"
            android:textSize="16sp"
            android:layout_marginBottom="24dp" />

        <!-- 두 번째 추천 코디 -->
        <TextView
            android:text="두 번째 추천 코디"
            android:textSize="18sp"
            android:textStyle="bold"
            android:layout_marginBottom="8dp" />

        <TextView
            android:id="@+id/outfit2"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="상의: 반팔\n하의: 긴바지\n아우터: 얇은 셔츠\n신발: 단화"
            android:textSize="16sp"
            android:layout_marginBottom="24dp" />

        <!-- 추천 색상 -->
        <TextView
            android:text="오늘의 추천 색깔"
            android:textSize="18sp"
            android:textStyle="bold"
            android:layout_marginBottom="8dp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginBottom="24dp">

            <!-- 색상 원 -->
            <View android:layout_width="40dp" android:layout_height="40dp" android:layout_marginEnd="8dp" android:background="@drawable/circle_white" />
            <View android:layout_width="40dp" android:layout_height="40dp" android:layout_marginEnd="8dp" android:background="@drawable/circle_pink" />
            <View android:layout_width="40dp" android:layout_height="40dp" android:layout_marginEnd="8dp" android:background="@drawable/circle_blue" />
            <View android:layout_width="40dp" android:layout_height="40dp" android:layout_marginEnd="8dp" android:background="@drawable/circle_purple" />
            <View android:layout_width="40dp" android:layout_height="40dp" android:background="@drawable/circle_yellow" />
        </LinearLayout>

        <!-- 필수품 -->
        <TextView
            android:text="필수품"
            android:textSize="18sp"
            android:textStyle="bold"
            android:layout_marginBottom="8dp" />

        <TextView
            android:id="@+id/essentials"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="마스크, 우산, 집합"
            android:textSize="16sp"
            android:layout_marginBottom="24dp" />
    </LinearLayout>
</ScrollView>