<?xml version="1.0" encoding="utf-8"?>
<resources xmlns:tools="http://schemas.android.com/tools">

    <!-- Base application theme. -->
    <style name="Base.Theme.DailyWeather" parent="Theme.Material3.DayNight.NoActionBar">
        <!-- Customize your light theme here. -->
        <!-- <item name="colorPrimary">@color/my_light_primary</item> -->

        <!-- ✅ 버튼 색상 문제 해결용 색상 설정 -->
        <item name="colorPrimary">@android:color/white</item>         <!-- 버튼 테두리/배경 -->
        <item name="colorOnPrimary">#3E3E3E</item>                    <!-- 버튼 텍스트 -->
        <item name="colorSurface">@android:color/white</item>        <!-- 버튼 배경 -->
        <item name="colorOnSurface">#3E3E3E</item>                    <!-- 버튼 텍스트 -->
    </style>

    <style name="Theme.DailyWeather" parent="Base.Theme.DailyWeather" />

    <style name="Theme.App.Splash" parent="Theme.SplashScreen">
        <item name="android:windowSplashScreenBackground">#77ADFE</item>
        <item name="android:windowSplashScreenAnimatedIcon">@drawable/logo</item>
        <item name="android:windowSplashScreenIconBackgroundColor">@color/white</item>

        <!-- 스플래시 이후 적용할 실제 앱 테마 -->
        <item name="postSplashScreenTheme">@style/Theme.DailyWeather</item>
    </style>

</resources>