<?xml version="1.0" encoding="utf-8"?>

<navigation
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/nav_intro"
    app:startDestination="@id/splashFragment">

    <fragment
        android:id="@+id/splashFragment"
        android:name="com.smartapp.dailyweather.ui.intro.SplashFragment"
        android:label="SplashFragment">

        <action
            android:id="@+id/action_splash_to_locationGps"
            app:destination="@id/locationGpsFragment" />
    </fragment>

    <fragment
        android:id="@+id/loadingFragment"
        android:name="com.smartapp.dailyweather.ui.intro.LoadingFragment"
        android:label="LoadingFragment"
        tools:layout="@layout/fragment_loading">

        <action
            android:id="@+id/action_loading_to_locationGps"
            app:destination="@id/locationGpsFragment" />
    </fragment>

    <fragment
        android:id="@+id/locationFailFragment"
        android:name="com.smartapp.dailyweather.ui.intro.LocationFailFragment"
        android:label="LocationFailFragment"
        tools:layout="@layout/fragment_location_fail" />

    <fragment
        android:id="@+id/locationGpsFragment"
        android:name="com.smartapp.dailyweather.ui.intro.LocationGpsFragment"
        android:label="LocationGpsFragment">

        <action
            android:id="@+id/action_locationGps_to_manualLocation"
            app:destination="@id/manualLocationFragment" />

        <action
            android:id="@+id/action_locationGps_to_selectQuestion"
            app:destination="@id/selectQuestionFragment" />
    </fragment>

    <fragment
        android:id="@+id/manualLocationFragment"
        android:name="com.smartapp.dailyweather.ui.intro.ManualLocationFragment"
        android:label="ManualLocationFragment">

        <action
            android:id="@+id/action_manualLocation_to_selectQuestion"
            app:destination="@id/selectQuestionFragment" />
    </fragment>

    <fragment
        android:id="@+id/manualLocationDetailFragment"
        android:name="com.smartapp.dailyweather.ui.intro.ManualLocationDetailFragment"
        android:label="ManualLocationDetailFragment"
        tools:layout="@layout/fragment_manual_location_detail" />

    <fragment
        android:id="@+id/selectQuestionFragment"
        android:name="com.smartapp.dailyweather.ui.intro.SelectQuestionFragment"
        android:label="SelectQuestionFragment" />

</navigation>
